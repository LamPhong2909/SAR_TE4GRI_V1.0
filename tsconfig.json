{
  "compilerOptions": {
    // "ESNext" đôi khi quá mới cho một số môi trường runtime của Mini App.
    // "ES2020" là một lựa chọn an toàn và hiện đại hơn, được hỗ trợ rộng rãi.
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    // "bundler" là tùy chọn được khuyến nghị cho các bundler hiện đại như Vite.
    // Nó sẽ đảm bảo cách resolve module nhất quán hơn giữa TypeScript và Vite.
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* ================================================================== */
    /* === HIỆU CHỈNH CHIẾN LƯỢC: ĐƯA MỌI THỨ VỀ CÙNG MỘT HỆ QUY CHIẾU === */
    /* ================================================================== */

    // BƯỚC 1: Đặt 'baseUrl' về thư mục gốc của toàn bộ dự án.
    "baseUrl": ".",

    // BƯỚC 2: Viết lại các đường dẫn một cách tường minh từ thư mục gốc.
    // QUAN TRỌNG: Hãy chắc chắn rằng bạn đã cấu hình alias tương ứng trong vite.config.ts
    // (ví dụ: sử dụng plugin 'vite-tsconfig-paths') để bundler có thể hiểu các đường dẫn này.
    "paths": {
      "components/*": ["./src/components/*"],
      "pages/*": ["./src/pages/*"],
      "state": ["./src/state.ts"],
      "static/*": ["./src/static/*"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"],
      "hooks": ["./src/hooks.ts"],
    }
  },
  // Đảm bảo rằng TypeScript cũng kiểm tra các file config ở gốc (nếu có).
  "include": ["src", "vite.config.ts"]
}
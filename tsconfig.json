{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* ================================================================== */
    /* === HIỆU CHỈNH CHIẾN LƯỢC: ĐƯA MỌI THỨ VỀ CÙNG MỘT HỆ QUY CHIẾU === */
    /* ================================================================== */

    // BƯỚC 1: Đặt 'baseUrl' về thư mục gốc của toàn bộ dự án.
    "baseUrl": ".",

    // BƯỚC 2: Viết lại các đường dẫn một cách tường minh từ thư mục gốc.
    "paths": {
      "components/*": ["src/components/*"],
      "pages/*": ["src/pages/*"],
      "state": ["src/state.ts"],
      "static/*": ["src/static/*"],
      "types/*": ["src/types/*"],
      "utils/*": ["src/utils/*"],
      "hooks": ["src/hooks.ts"]
    }
  },
  "include": ["src"],

}